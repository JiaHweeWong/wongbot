# ── Local development only (docker-compose) ──────────────────────────────────
# The backend is no longer deployed; Vercel handles everything.
# These vars are only needed when running docker-compose locally.

# LiteLLM model string: "provider/model-name"
LLM_MODEL=gemini/gemini-2.5-flash

# API key for your chosen provider — LiteLLM reads these automatically
GEMINI_API_KEY=
GOOGLE_API_KEY=         # newer LiteLLM versions use this for gemini/* models

CONTENT_DIR=/content
RATE_LIMIT_PER_DAY=10
ALLOWED_ORIGINS=["http://localhost:3000"]
