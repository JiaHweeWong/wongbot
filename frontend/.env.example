# ── Required ──────────────────────────────────────────────────────────────────

# Gemini API key (Google AI Studio: aistudio.google.com)
GOOGLE_API_KEY=

# Upstash Redis — used for rate limiting (upstash.com, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────

# Gemini model to use (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
